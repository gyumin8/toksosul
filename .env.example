# 복사해서 .env 로 이름 바꾸고 값을 채우세요.
# 이 파일은 .gitignore에 들어 있어 깃에 올라가지 않습니다. 키는 반드시 여기에만 둡니다.

# ===== 텍스트: Google Gemini =====
# 키 발급: https://aistudio.google.com/apikey  (AIza... 로 시작)
# 비워두면 목(mock) 응답 모드 -> 키 없이도 전체 플로우 테스트 가능
GEMINI_API_KEY=

# 모델명은 자주 바뀝니다. 404가 나면 아래 값을 바꿔보세요.
# gemini-3.5-flash-lite (싸고 빠름) / gemini-3.5-flash / gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# ===== 이미지: Cloudflare Workers AI (무료) =====
# Account ID: Cloudflare 대시보드 우측의 32자리 문자열
# API Token: 내 프로필 > API Tokens > Create Token > Workers AI 권한 부여
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 이미지 벤더 강제 지정: cloudflare / gemini / off
# 비워두면 위 키를 보고 알아서 고릅니다 (Cloudflare 우선)
IMAGE_PROVIDER=

# 삽화 생성을 끄고 플레이스홀더만 쓰려면 0
ENABLE_IMAGE_GEN=1

# ===== 기타 =====
# 개발은 SQLite, 배포 시 PostgreSQL 주소로 교체
DATABASE_URL=sqlite:///./toksosul.db

# 혼자 테스트할 때만 1. 제출 전에는 이 줄을 지우세요 (서비스 규칙은 2명)
MIN_MEMBERS=1
